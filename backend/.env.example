# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format). Points prisma migrate/seed
# and the running app at the same database. Get this from Neon (or your own
# local Postgres instance).
DATABASE_URL="postgresql://user:password@localhost:5432/flowboard?schema=public"

# Port the NestJS server listens on.
PORT=4000

# Secret used to sign JWTs (the httpOnly auth cookie). Any long random
# string works locally, e.g. `openssl rand -base64 32`. Changing this
# invalidates every existing session cookie, since old tokens won't verify
# against the new secret.
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed CORS origins (the deployed frontend
# URL(s)). Locally this is the frontend dev server's origin.
CORS_ORIGIN="http://localhost:3000"

# Read in auth.controller.ts (isProd()) to decide the session cookie's
# Secure/SameSite flags: 'production' gets Secure + SameSite=None (required
# for the cross-origin Vercel<->Render cookie in the deployed app), anything
# else gets a relaxed cookie, since browsers reject Secure cookies over
# plain http://localhost. Found by grepping process.env usage in src/ — not
# previously documented anywhere, and not declared in render.yaml either,
# so in production it's either a Render platform default or was set
# directly in Render's dashboard outside the blueprint. Leave this unset
# for local dev. Setting NODE_ENV=production here breaks guest login
# locally, since the browser silently drops the Secure cookie over http.
# NODE_ENV=production
