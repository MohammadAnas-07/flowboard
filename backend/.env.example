# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://user:password@localhost:5432/flowboard?schema=public"

# Port the NestJS server listens on
PORT=4000

# Secret used to sign JWTs (httpOnly auth cookie)
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed CORS origins (the deployed frontend URL(s))
CORS_ORIGIN="http://localhost:3000"
